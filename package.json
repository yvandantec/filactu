{
  "name": "filactu",
  "version": "1.4.0",
  "private": true,
  "type": "module",
  "description": "FilActu - lecteur de fils RSS personnel, inspiré de Feedly, synchronisé via GitHub",
  "license": "MIT",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit && vite build",
    "preview": "vite preview",
    "collect": "tsx collector/main.ts",
    "test": "vitest run",
    "test:watch": "vitest",
    "test:coverage": "vitest run --coverage",
    "test:e2e": "playwright test",
    "check": "tsc --noEmit",
    "trace": "node scripts/trace.mjs",
    "verify": "npm run check && npm run test:coverage && npm run build && npm run test:e2e && npm run trace",
    "quality": "lhci autorun",
    "captures": "playwright test --config playwright.captures.config.ts"
  },
  "dependencies": {
    "@fontsource/barlow": "^5.1.0",
    "@fontsource/barlow-condensed": "^5.1.0",
    "fast-xml-parser": "^4.5.0",
    "idb-keyval": "^6.2.1",
    "preact": "^10.24.0"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.10.1",
    "@lhci/cli": "^0.14.0",
    "@playwright/test": "^1.48.0",
    "@preact/preset-vite": "^2.9.0",
    "@testing-library/preact": "^3.2.4",
    "@types/node": "^22.7.0",
    "@vitest/coverage-v8": "^2.1.0",
    "jsdom": "^25.0.0",
    "tsx": "^4.19.0",
    "typescript": "^5.6.0",
    "vite": "^5.4.0",
    "vitest": "^2.1.0",
    "yaml": "^2.9.1"
  }
}
