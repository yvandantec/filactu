    <style name="Theme.FilActu" parent="android:Theme.Material.Light.NoActionBar">
        <item name="android:colorPrimary">@color/filactu_ink</item>
        <item name="android:colorAccent">@color/filactu_ink</item>
        <item name="android:windowBackground">@color/filactu_bg</item>
        <item name="android:statusBarColor">@color/filactu_bg</item>
        <item name="android:navigationBarColor">@color/filactu_bg</item>
        <item name="android:windowLightStatusBar">true</item>
        <item name="android:windowLightNavigationBar">true</item>
    </style>
</resources>
