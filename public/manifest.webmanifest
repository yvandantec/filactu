{
  "id": "/filactu/app",
  "name": "FilActu",
  "short_name": "FilActu",
  "description": "Lecteur de fils RSS personnel, synchronisé sur tous vos appareils",
  "lang": "fr",
  "start_url": "./",
  "scope": "./",
  "display": "standalone",
